[Unit]
Description=Maxwell-V1-Flash on strata-mx (RTX 5060), backend 127.0.0.1:18094
# stopped when the idle proxy exits (no request for MX_IDLE); the engine writes its KV on the way out
StopWhenUnneeded=yes

[Service]
Type=simple
EnvironmentFile=%h/.config/strata-maxwell/env
ExecStart=%h/.local/share/strata-maxwell/venv/bin/python %h/workspace/strata-maxwell/serve/maxwell_server.py \
  --engine %h/workspace/strata-maxwell/build/strata-mx --tokenizer %h/models/maxwell-v1-flash/tokenizer \
  --host 127.0.0.1 --port 18094 --model-name maxwell \
  --log %h/.local/state/strata-maxwell/engine.log -- \
  --model %h/models/maxwell-v1-flash/Maxwell-V1-Flash-AD-Q4_K-IQ4_XS.gguf \
  --mtp %h/models/maxwell-v1-flash/Maxwell-V1-Flash-MTP.gguf \
  --ctx ${MX_CTX} --chunk 2048 --kv-file %h/.local/state/strata-maxwell/session.kv $MX_EXTRA
# started = answering: the proxy forwards only then
ExecStartPost=/bin/sh -c "for i in $(seq 1 240); do curl -sf http://127.0.0.1:18094/health >/dev/null && exit 0; sleep 1; done; exit 1"
KillMode=mixed
KillSignal=SIGTERM
TimeoutStartSec=300
TimeoutStopSec=180
Restart=no
